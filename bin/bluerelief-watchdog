#!/bin/sh
# bluerelief-watchdog — detects three distinct "looks alive but isn't playing"
# failure modes in librespot and restarts raspotify.
#
# Failure mode A — local event loop wedged.
#   librespot's process is alive but its event loop has stopped servicing
#   requests (often after a burst of Symphonia decode errors). systemd's
#   Restart= can't see this because the process is technically running.
#   Symptom: Spotify shows "BlueRelief" in the device list but clicking it spins
#   forever; the DAC is held; nothing plays.
#   Probe: ZeroConf HTTP endpoint `?action=getInfo`. Returns 200 + JSON when
#   the local event loop is healthy, times out when wedged.
#
# Failure mode B — dealer websocket wedged.
#   The connection to Spotify's *cloud* dealer (the long-lived WebSocket that
#   carries playback context, queue, "next track" signals) has died but
#   librespot's local event loop is still happy. ZeroConf still answers 200
#   — they're independent sockets. User-facing symptom: a track plays to its
#   natural end, then nothing happens, OR playback stops mid-song with
#   "Spotify can't play this right now" on the phone.
#   Probe: scan raspotify's journal for the dealer-down fingerprint
#   ("channel closed" / "Websocket peer does not respond") in the last 3
#   minutes; ≥3 hits = sustained, not a transient blip.
#
# Failure mode C — logged in, but no connection to Spotify left.
#   librespot loses its AP session and never opens a new one. ZeroConf keeps
#   answering 200 and naming the account as activeUser, and there is no dealer
#   left to complain, so A and B both pass. The log cannot be trusted to say
#   so: on 2026-09-27 the last line was "Connection to server closed.", on
#   2026-10-16 (router reboot) a single "Websocket peer does not respond.",
#   because the AP keep-alive timeout shuts the session down without logging.
#   User-facing symptom: the board vanishes from Spotify, and tapping it on the
#   phone does nothing. Lasted 2.5 days the first time, 32 h the second.
#   Probe: getInfo names an activeUser, yet librespot has held no TCP
#   connection other than ZeroConf clients for ≥10 minutes. Not less: on
#   2026-09-29 a dropped session came back on its own after 201 s, keeping its
#   credentials — a restart would have lost them, since the credential cache
#   is off. It reads librespot's own state rather than asking the Web API
#   whether the device is listed, because that token sees one account and the
#   wedged session belonged to another.
#
# Behavior:
#   - Modes B and C are in-band: 3 errors in 3 minutes, or 10 minutes logged
#     in with no connection, IS the confirmation — restart on the first
#     watchdog tick that observes it.
#   - Mode A uses a two-miss confirmation (legacy behavior) — single missed
#     ZeroConf probes are sometimes transient (DNS hiccup, etc.).
#   - 5-minute cooldown after any restart so the new librespot has time to
#     come up before its absence trips the probe again.
#
# Driven by bluerelief-watchdog.timer every 2 minutes.

set -u

LOG() {
    logger -t bluerelief-watchdog "$*"
    echo "$(date -u +%FT%TZ) $*"
}

restart_raspotify() {
    reason=$1
    rm -f "$MISS" "$OFFLINE"
    if systemctl restart raspotify; then
        touch "$RESTARTED"
        LOG "raspotify restart issued ($reason)"
    else
        LOG "ERROR: systemctl restart raspotify failed ($reason)"
    fi
}

MISS=/run/bluerelief-watchdog.miss
OFFLINE=/run/bluerelief-watchdog.offline
RESTARTED=/run/bluerelief-watchdog.last-restart

# Cooldown: skip checks while raspotify is still coming up after our restart.
if [ -f "$RESTARTED" ]; then
    age=$(( $(date +%s) - $(stat -c %Y "$RESTARTED") ))
    if [ "$age" -lt 300 ]; then
        exit 0
    fi
    rm -f "$RESTARTED"
fi

# ── Probe B: dealer websocket health ────────────────────────────────────
# Count dealer-down signals in the last 3 minutes. The window matches the
# timer cadence × 1.5 so two adjacent timer firings see overlapping data
# and a real wedge doesn't slip between probes.
dealer_errs=$(journalctl -u raspotify --since "3 minutes ago" --no-pager -q 2>/dev/null \
              | grep -cE "(channel closed|Websocket peer does not respond)")
if [ "${dealer_errs:-0}" -ge 3 ]; then
    LOG "WEDGE-B confirmed: ${dealer_errs} dealer/websocket errors in last 3m"
    restart_raspotify "dealer wedge"
    exit 0
fi

# Discover librespot's ZeroConf listening port (chosen randomly per startup).
port=$(ss -tlnp 2>/dev/null | awk '/users:\(\("librespot"/ {
    n = split($4, a, ":"); print a[n]; exit
}')

# librespot's established TCP connections, minus ZeroConf clients.
links=$(ss -Htnp state established 2>/dev/null | awk -v zc=":${port}\$" '
    /users:\(\("librespot"/ && $3 !~ zc { n++ } END { print n + 0 }')

info=
if [ -n "$port" ]; then
    info=$(curl --max-time 4 -fsS "http://127.0.0.1:${port}/?action=getInfo") || info=
fi
user=$(printf '%s' "$info" | sed -n 's/.*"activeUser":"\([^"]*\)".*/\1/p')

# ── Probe C: logged in, no connection to Spotify ────────────────────────
# OFFLINE's mtime is the tick that first saw the board logged in but unlinked.
if [ -n "$user" ] && [ "$links" -eq 0 ]; then
    if [ ! -f "$OFFLINE" ]; then
        touch "$OFFLINE"
        LOG "logged in with no connection to Spotify; restart in 10m unless it reconnects"
    else
        gone=$(( $(date +%s) - $(stat -c %Y "$OFFLINE") ))
        if [ "$gone" -ge 600 ]; then
            LOG "WEDGE-C confirmed: logged in, no connection to Spotify for ${gone}s"
            restart_raspotify "session wedge"
            exit 0
        fi
    fi
elif [ -f "$OFFLINE" ]; then
    [ "$links" -gt 0 ] && LOG "reconnected on its own after $(( $(date +%s) - $(stat -c %Y "$OFFLINE") ))s"
    rm -f "$OFFLINE"
fi

# ── Probe A: local event loop via ZeroConf ──────────────────────────────
if [ -n "$info" ]; then
    [ -f "$MISS" ] && LOG "recovered (port :${port})"
    rm -f "$MISS"
    exit 0
fi

# Miss. Two consecutive misses required before acting.
if [ ! -f "$MISS" ]; then
    LOG "miss 1/2 (port='${port:-none}'); will recheck in 2m"
    touch "$MISS"
    exit 0
fi

LOG "WEDGE-A confirmed: ZeroConf unresponsive (port='${port:-none}')"
restart_raspotify "zeroconf wedge"
