[Unit]
Description=BlueRelief screen power daemon (playback-aware DP blanking)
After=bluerelief-kiosk.service bluerelief-gio.service bluerelief-web.service
Requires=bluerelief-kiosk.service bluerelief-web.service

[Service]
Type=simple
User=ding
ExecCondition=/usr/local/bin/bluerelief-config check PANEL
# SCREEN_IDLE comes from here.
EnvironmentFile=-/etc/BlueRelief/bluerelief.conf
Environment=XDG_RUNTIME_DIR=/run/user/1001
ExecStart=/usr/local/bin/bluerelief-screen
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
