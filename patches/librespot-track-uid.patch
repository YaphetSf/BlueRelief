+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn skip_to(uid: Option<&str>, uri: Option<&str>, index: Option<u32>) -> SkipTo {
+        SkipTo {
+            track_uid: uid.map(str::to_string),
+            track_uri: uri.map(str::to_string),
+            track_index: index,
+        }
+    }
+
+    #[test]
+    fn uid_is_used_when_uri_is_empty() {
+        // what mobile actually sends when a track is tapped in a context
+        let track = PlayingTrack::try_from(skip_to(Some("7cf9e2594c7895245cf8"), Some(""), None));
+        assert!(
+            matches!(track, Ok(PlayingTrack::Uid(ref uid)) if uid == "7cf9e2594c7895245cf8"),
+            "expected the uid to be used, got {track:?}"
+        );
+    }
+
+    #[test]
+    fn uri_still_wins_when_present() {
+        let track = PlayingTrack::try_from(skip_to(
+            Some("7cf9e2594c7895245cf8"),
+            Some("spotify:track:3altlFsOlTnZYDuBsorZAy"),
+            None,
+        ));
+        assert!(
+            matches!(track, Ok(PlayingTrack::Uri(ref uri)) if uri == "spotify:track:3altlFsOlTnZYDuBsorZAy"),
+            "expected the uri to be used, got {track:?}"
+        );
+    }
+
+    #[test]
+    fn index_zero_survives_empty_uri_and_uid() {
+        let track = PlayingTrack::try_from(skip_to(Some(""), Some(""), Some(0)));
+        assert!(
+            matches!(track, Ok(PlayingTrack::Index(0))),
+            "expected index 0, got {track:?}"
+        );
+    }
+
+    #[test]
+    fn nothing_to_skip_to_is_an_error() {
+        assert!(PlayingTrack::try_from(skip_to(Some(""), Some(""), None)).is_err());
+        assert!(PlayingTrack::try_from(skip_to(None, None, None)).is_err());
+    }
+}
